<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Bundled LaunchAgent: lives at Contents/Library/LaunchAgents/ inside
         SkylightService.app and is registered with SMAppService by
         `skylight register`. BundleProgram is relative to the bundle root, so
         the same plist works wherever the .app is installed. -->
    <key>Label</key><string>com.skylight.SkylightService</string>
    <key>BundleProgram</key><string>Contents/MacOS/SkylightService</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><false/>
    <!-- No StandardErrorPath: launchd plists cannot expand $HOME. The daemon
         redirects its own stderr to ~/Library/Logs/skylight/service.log
         when this variable is set. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>SKYLIGHT_STDERR_TO_LOG</key><string>1</string>
    </dict>
</dict>
</plist>
