#!/usr/bin/env bash
# skylight-install — sign SkylightService.app and register the LaunchAgent.
#
# Run once after `brew install`/`brew reinstall` (Homebrew sandboxes
# post_install, which blocks the keychain lookups codesign needs, so this
# step cannot happen inside the formula). Re-running is idempotent.
#
# Identity: $SKYLIGHT_SIGNING_IDENTITY, else the first of "Skylight Dev",
# "Developer ID Application", "Apple Development" found in the keychain.
# A STABLE identity is what lets Accessibility/Screen Recording grants
# survive upgrades — see scripts/package-app.sh.
set -euo pipefail

BASE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
APP="$BASE/build/SkylightService.app"
[ -d "$APP" ] || { echo "skylight-install: $APP missing — in a repo checkout run scripts/package-app.sh + scripts/install-launchagent.sh instead" >&2; exit 1; }

IDENTITY="${SKYLIGHT_SIGNING_IDENTITY:-}"
if [ -z "$IDENTITY" ]; then
  identities="$(security find-identity -v -p codesigning 2>/dev/null || true)"
  for name in "Skylight Dev" "Developer ID Application" "Apple Development"; do
    IDENTITY="$(printf '%s\n' "$identities" | sed -n "s/.*\"\($name[^\"]*\)\".*/\1/p" | head -1)"
    [ -n "$IDENTITY" ] && break
  done
fi
[ -n "$IDENTITY" ] || {
  echo "skylight-install: no codesigning identity found." >&2
  echo "Create one in Keychain Access (Certificate Assistant > Create a Certificate," >&2
  echo "name: Skylight Dev, type: Code Signing) or set SKYLIGHT_SIGNING_IDENTITY." >&2
  exit 1
}

echo "Signing with '$IDENTITY'"
codesign --force --sign "$IDENTITY" --identifier com.skylight.SkylightService "$APP"
codesign --verify --strict "$APP"
exec bash "$BASE/scripts/install-launchagent.sh"
