#!/usr/bin/env bash
# skylight-run — run a Skylight driver with the daemon guaranteed up.
#
# Wraps the two things every driver needs and the two things everyone gets
# wrong (see CLAUDE.md gotchas): ensures the daemon is running first, and
# runs driver code in an ESM context so top-level await works.
#
# Usage:
#   skylight-run <driver.ts|.mts>   run a driver file (write .mts outside ts/,
#                                   or use an async main(); `sky` must be
#                                   imported from <repo>/ts/src/index.js)
#   skylight-run -e '<code>'        inline driver code; `sky` is pre-imported
#                                   and closed for you, top-level await OK
#   skylight-run --status           daemon / socket / permission report
#   skylight-run --stop             stop the daemon (SIGTERM; unlinks socket)
#   skylight-run --mcp              serve Skylight as an MCP server on stdio
#                                   (claude mcp add skylight -- skylight-run --mcp)
#
# SKYLIGHT_BACKGROUND=1 skylight-run ...  starts the daemon (if not already
# running) in no-focus-steal mode. Only applies at daemon start; --stop first
# to switch modes.
set -euo pipefail

# Two layouts, detected by whether this script sits inside SkylightService.app:
#   repo:      <repo>/scripts/skylight-run, ts client at <repo>/ts, debug
#              daemon spawned as a dev-flow terminal child
#   installed: SkylightService.app/Contents/Resources/bin/skylight-run (the
#              cask symlinks it into brew's bin). The TS client source ships
#              in Contents/Resources/ts; its node_modules are installed per
#              user under ~/Library/Application Support/skylight/ts-<version>
#              so nothing is written inside the signed bundle. The daemon is
#              owned by the bundled LaunchAgent (`skylight register`); TCC
#              needs the launchd-launched .app, so this script never spawns it.
BASE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
SOCK="$HOME/Library/Application Support/skylight/ipc/computeruse.sock"
LOG="$HOME/Library/Logs/skylight/daemon.log"
AGENT_LABEL="com.skylight.SkylightService"

if [ -f "$BASE/../Info.plist" ]; then
  INSTALLED=1
  CONTENTS="$(cd "$BASE/.." && pwd)"
  VERSION="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$CONTENTS/Info.plist" 2>/dev/null || echo unknown)"
  TS_SRC="$BASE/ts"
  TS_DIR="$HOME/Library/Application Support/skylight/ts-$VERSION"
  DAEMON="" # launchd-managed; see ensure_daemon
  CLI="$CONTENTS/MacOS/skylight"
else
  INSTALLED=0
  TS_DIR="$BASE/ts"
  DAEMON="$BASE/.build/debug/SkylightService"
  CLI="$BASE/.build/debug/skylight"
fi
TSX="$TS_DIR/node_modules/.bin/tsx"

die() { echo "skylight-run: $*" >&2; exit 1; }

socket_live() {
  # A leftover socket file from a killed daemon still exists but refuses
  # connections — probe it for real instead of trusting `ls`.
  [ -S "$SOCK" ] && "$TSX" -e '
    const net = require("node:net");
    const s = net.connect(process.argv[1]);
    s.on("connect", () => { s.end(); process.exit(0); });
    s.on("error", () => process.exit(1));
    setTimeout(() => process.exit(1), 1000);
  ' "$SOCK" 2>/dev/null
}

ensure_deps() {
  if [ "$INSTALLED" = 1 ] && [ ! -d "$TS_DIR" ]; then
    # First run of this version: stage the client outside the bundle, then
    # install its deps with the user's node (not a brew dependency, so an
    # nvm-managed node keeps working).
    mkdir -p "$(dirname "$TS_DIR")"
    cp -R "$TS_SRC" "$TS_DIR.tmp.$$" && mv "$TS_DIR.tmp.$$" "$TS_DIR"
  fi
  [ -x "$TSX" ] || (cd "$TS_DIR" && npm install --silent) || die "npm install failed in $TS_DIR"
  if [ "$INSTALLED" = 0 ] && [ ! -x "$DAEMON" ]; then
    echo "skylight-run: building daemon..." >&2
    (cd "$BASE" && swift build) || die "swift build failed"
  fi
}

ensure_daemon() {
  socket_live && return 0
  ensure_deps
  mkdir -p "$(dirname "$LOG")"
  if [ "$INSTALLED" = 1 ]; then
    # Installed mode never spawns a terminal-child daemon: TCC grants belong
    # to the launchd-launched SkylightService.app, and a shell-spawned copy
    # would run permission-less. `skylight start` kicks the LaunchAgent (and
    # says how to register it if that never happened). stderr only: in --mcp
    # mode stdout is the transport.
    "$CLI" start >&2 || die "cannot start $AGENT_LABEL — see above and ~/Library/Logs/skylight/service.log"
  else
    echo "skylight-run: starting SkylightService${SKYLIGHT_BACKGROUND:+ (background mode)}..." >&2
    # Detached so it survives this shell; dev-flow launch is fine for TCC here
    # because the local debug binary already holds its grants (see CLAUDE.md).
    nohup "$DAEMON" >> "$LOG" 2>&1 &
    disown
  fi
  for _ in $(seq 1 50); do
    socket_live && return 0
    sleep 0.2
  done
  die "daemon did not come up within 10s — check $LOG and '$CLI doctor'"
}

case "${1:-}" in
  --status)
    ensure_deps
    "$CLI" doctor
    pgrep -fl SkylightService || echo "daemon: not running"
    exit 0
    ;;
  --stop)
    pkill -TERM -f SkylightService 2>/dev/null && echo "stopped" || echo "not running"
    exit 0
    ;;
  --ts-dir)
    ensure_deps
    echo "$TS_DIR"
    exit 0
    ;;
  --mcp)
    # stdio is the MCP transport: nothing above may write to stdout (all the
    # helpers here log to stderr), and the daemon must be up before the first
    # tool call rather than lazily inside one.
    ensure_daemon
    exec "$TSX" "$TS_DIR/src/mcp.ts"
    ;;
  -e)
    [ -n "${2:-}" ] || die "usage: skylight-run -e '<code>'"
    ensure_daemon
    TMPDIR_DRIVER="$(mktemp -d)"
    TMP="$TMPDIR_DRIVER/driver.mts"   # .mts forces ESM => top-level await works
    {
      echo "import { sky } from '$TS_DIR/src/index.js';"
      echo "try {"
      cat <<<"$2"
      echo "} finally { sky.close(); }"
    } > "$TMP"
    # No `exec` here (unlike the file-driver branch below): exec replaces the
    # shell, so a trap on it would never fire. Run in-process instead so we
    # can clean up the mktemp -d dir afterwards regardless of exit status.
    # (set +e/-e around the call: under `set -e` a bare failing command would
    # abort the script before the cleanup line ever ran.)
    set +e
    "$TSX" "$TMP"
    status=$?
    set -e
    rm -rf "$TMPDIR_DRIVER"
    exit $status
    ;;
  -*|"")
    grep '^#' "$0" | sed -n '2,20p' | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
  *)
    [ -f "$1" ] || die "no such driver file: $1"
    ensure_daemon
    exec "$TSX" "$@"
    ;;
esac
